{
  "color": {
    "$type": "color",
    "$extensions": { "design-spec": { "tier": "primitive" } },
    "red": { "6": { "$value": "#e5484d" } },
    "gray": { "1": { "$value": "#ffffff" }, "12": { "$value": "#1a1a1a" } },
    "action": {
      "$extensions": { "design-spec": { "tier": "semantic" } },
      "primary": {
        "$value": "{color.red.6}",
        "$extensions": { "design-spec": { "dark": "{color.red.6}" } }
      }
    },
    "surface": {
      "$extensions": { "design-spec": { "tier": "semantic" } },
      "background": {
        "$value": "{color.gray.1}",
        "$extensions": { "design-spec": { "dark": "{color.gray.12}" } }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "$extensions": { "design-spec": { "tier": "semantic" } },
    "control": { "$value": "6px" }
  }
}
