          "$value": "#FBEBE9"
        },
        "6": {
          "$value": "#C0342B"
        },
        "7": {
          "$value": "#9B2820"
        }
      },
      "paperstock": {
        "$description": "The cream the printed sheets are actually rendered on (sheet_template.html --paper). Present so the stage neutral can be reasoned about against it.",
        "cream": {
          "$value": "#F7F5EC"
        }
      }
    },
    "surface": {
      "$extensions": {
        "design-spec": {
          "tier": "semantic"
        }
      },
      "page": {
        "$description": "The rail and app ground.",
        "$value": "{color.primitive.stone.1}",
        "$extensions": {
          "design-spec": {
            "dark": "{color.primitive.stone.12}"
          }
        }
      },
      "card": {
        "$description": "Raised panels, expanders, popovers, gallery tiles.",
        "$value": "{color.primitive.stone.0}",
        "$extensions": {
          "design-spec": {
            "dark": "#12160F"
          }
        }
      },
      "subtle": {
        "$description": "Quiet fill for grouped rows and inset bodies.",
        "$value": "{color.primitive.stone.2}",
        "$extensions": {
          "design-spec": {
            "dark": "rgba(255,255,255,.045)"
          }
        }
      },
      "sunken": {
        "$description": "Input wells and inset tracks.",
        "$value": "{color.primitive.stone.3}",
        "$extensions": {
          "design-spec": {
            "dark": "#0A0D0A"
          }
        }
      },
      "stage": {
        "$description": "The mat the printed sheet sits on. Deliberately the darkest chrome value so the cream sheet is the brightest thing on screen (Principle 4).",
        "$value": "{color.primitive.stone.5}",
        "$extensions": {
          "design-spec": {
            "dark": "#060806"
          }
        }
      },
      "paper": {
        "$description": "The sheet itself. Never used for chrome — only for the artifact and its thumbnails.",
        "$value": "{color.primitive.paperstock.cream}"
