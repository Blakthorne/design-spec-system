{
  "$description": "DTCG design tokens. Primitives are raw values and MUST NOT be used directly in components — reference semantic tokens instead.",
  "color": {
    "$type": "color",
    "primitive": {
      "$extensions": { "design-spec": { "tier": "primitive" } },
      "gray": {
        "0": { "$value": "#ffffff" }, "1": { "$value": "#f5f5f5" },
        "8": { "$value": "#555555" }, "12": { "$value": "#111111" }
      },
      "blue": { "6": { "$value": "#3b6fe0" }, "7": { "$value": "#2f59b8" } },
      "red": { "6": { "$value": "#e5484d" } }
    },
    "action": {
      "$extensions": { "design-spec": { "tier": "semantic" } },
      "primary": {
        "$value": "{color.primitive.blue.6}",
        "$extensions": { "design-spec": { "dark": "{color.primitive.blue.7}" } }
      }
    },
    "feedback": {
      "$extensions": { "design-spec": { "tier": "semantic" } },
      "error": { "$value": "{color.primitive.red.6}" }
    },
    "surface": {
      "$extensions": { "design-spec": { "tier": "semantic" } },
      "background": {
        "$value": "{color.primitive.gray.0}",
        "$extensions": { "design-spec": { "dark": "{color.primitive.gray.12}" } }
      },
      "text": {
        "$value": "{color.primitive.gray.12}",
        "$extensions": { "design-spec": { "dark": "{color.primitive.gray.0}" } }
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$extensions": { "design-spec": { "tier": "semantic" } },
    "xs": { "$value": "4px" }, "sm": { "$value": "8px" },
    "md": { "$value": "16px" }, "lg": { "$value": "24px" }, "xl": { "$value": "40px" }
  },
  "radius": {
    "$type": "dimension",
    "$extensions": { "design-spec": { "tier": "semantic" } },
    "control": { "$value": "6px" }, "surface": { "$value": "12px" }
  },
  "font": {
    "$type": "fontFamily",
    "$extensions": { "design-spec": { "tier": "semantic" } },
    "body": { "$value": "system-ui, sans-serif" },
    "mono": { "$value": "ui-monospace, monospace" }
  }
}
