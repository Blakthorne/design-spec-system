  "font": {
    "$type": "fontFamily",
    "$extensions": {
      "design-spec": {
        "tier": "semantic"
      }
    },
    "display": {
      "$description": "Section identity and the wordmark. Source Serif 4 ties the chrome to the sheets it produces (their heads are set in it). Self-hosted variable woff2 — see foundations/typography.md.",
      "$value": "\"Source Serif 4\", \"Iowan Old Style\", Georgia, serif"
    },
    "body": {
      "$description": "All UI text. Atkinson Hyperlegible Next (Braille Institute, OFL) — chosen 2026-08-21 for maximum cold-read legibility: disambiguated 1/l/I/|, slashed 0, open apertures. Self-hosted variable woff2.",
      "$value": "\"Atkinson Hyperlegible Next\", \"Atkinson Hyperlegible\", \"Avenir Next\", \"Seravek\", ui-sans-serif, -apple-system, sans-serif"
    },
    "mono": {
      "$description": "Numbers that must align: coordinates, dimensions, counts. Atkinson Hyperlegible Mono keeps the same disambiguation in tabular contexts; system mono is the fallback.",
      "$value": "\"Atkinson Hyperlegible Mono\", ui-monospace, \"SF Mono\", Menlo, monospace"
    }
  },
