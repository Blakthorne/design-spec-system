      "scrim": {
        "$description": "Behind modals.",
        "$value": "rgba(38,36,29,.44)"
      }
    },
    "text": {
      "$extensions": {
        "design-spec": {
          "tier": "semantic"
        }
      },
      "primary": {
        "$description": "Headings and — per Principle 2 — the CURRENT VALUE on every summary row. 14.7:1 on page.",
        "$value": "{color.primitive.stone.11}",
        "$extensions": {
          "design-spec": {
            "dark": "#EEF2EC"
          }
        }
      },
      "secondary": {
        "$description": "Row labels and supporting copy. 7.4:1 on page.",
        "$value": "{color.primitive.stone.9}",
        "$extensions": {
          "design-spec": {
            "dark": "#96A49A"
          }
        }
      },
      "subtle": {
        "$description": "Hints, captions, notes. 4.6:1 on page — the floor. Nothing quieter than this may carry words.",
        "$value": "{color.primitive.stone.8}",
        "$extensions": {
          "design-spec": {
            "dark": "#8A9990"
          }
        }
      },
      "disabled": {
        "$description": "WCAG exempts inactive controls from contrast; even so, prefer explaining why a control is off (see patterns/states.md) over dimming it silently.",
        "$value": "{color.primitive.stone.6}",
        "$extensions": {
          "design-spec": {
            "dark": "#5C6A60"
          }
        }
      },
      "inverse": {
        "$value": "{color.primitive.stone.0}"
      },
      "brand": {
        "$description": "Crest green for wordmarks and section identity. 9.5:1 on card.",
        "$value": "{color.primitive.green.8}",
        "$extensions": {
          "design-spec": {
            "dark": "#8FD9AE"
          }
        }
      },
      "action": {
        "$description": "Inline links and text buttons. 5.4:1 on card.",
        "$value": "{color.primitive.green.7}",
        "$extensions": {
          "design-spec": {
            "dark": "#4DD68B"
          }
        }
      }
    },
    "border": {
      "$extensions": {
        "design-spec": {
          "tier": "semantic"
        }
      },
      "subtle": {
        "$description": "Dividers and decorative rules. Carries no information, so it is exempt from 3:1.",
        "$value": "{color.primitive.stone.4}",
        "$extensions": {
          "design-spec": {
            "dark": "rgba(255,255,255,.09)"
          }
        }
      },
      "control": {
        "$description": "The edge that MAKES a control identifiable — inputs, buttons, checkboxes. 3.4:1 on page, meeting SC 1.4.11.",
        "$value": "{color.primitive.stone.7}",
        "$extensions": {
          "design-spec": {
            "dark": "rgba(255,255,255,.38)"
          }
        }
      },
      "strong": {
        "$description": "Emphasised separation, e.g. the rail against the stage. Must be darker than border.control — the ramp reads subtle < control < strong.",
        "$value": "{color.primitive.stone.8}",
        "$extensions": {
          "design-spec": {
            "dark": "rgba(255,255,255,.52)"
          }
        }
      },
      "focus": {
        "$description": "Crest green, not the brighter green.7 — the ring has to clear 3:1 on the STAGE (the darkest chrome value), where green.7 reached only 2.90:1. Always drawn outside a gap of size.focus-offset filled with the surface behind it, so the ring stays visible even on a primary button of the same colour.",
        "$value": "{color.primitive.green.8}",
        "$extensions": {
          "design-spec": {
            "dark": "#1C9152"
          }
        }
      },
      "paper": {
        "$description": "Hairline around the sheet on the stage, so a white-edged page still reads as an object.",
        "$value": "rgba(38,36,29,.30)"
      }
    },
    "action": {
      "$extensions": {
        "design-spec": {
          "tier": "semantic"
        }
      },
      "primary": {
        "$description": "Export, Save — the terminal act. Crest green, white text at 9.5:1.",
        "$value": "{color.primitive.green.8}",
        "$extensions": {
          "design-spec": {
            "dark": "{color.primitive.green.8}"
          }
        }
      },
      "primary-hover": {
        "$value": "{color.primitive.green.9}"
      },
      "primary-text": {
        "$value": "{color.primitive.stone.0}"
      },
      "secondary": {
        "$description": "Secondary button fill — the sheet's own cream (option D, chosen 2026-08-21): every secondary act is printed on the paper it produces. Dark falls back to the card surface.",
        "$value": "{color.primitive.paperstock.cream}",
        "$extensions": {
          "design-spec": {
            "dark": "#12160F"
          }
        }
      },
      "secondary-hover": {
        "$description": "Hover moves the BORDER to crest green; the cream fill never changes (D's grammar: tone is identity, the edge is the affordance).",
        "$value": "{color.primitive.green.8}",
        "$extensions": {
          "design-spec": {
            "dark": "#1C9152"
          }
        }
