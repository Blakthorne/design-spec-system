    "$type": "color",
    "primitive": {
      "$extensions": {
        "design-spec": {
          "tier": "primitive"
        }
      },
      "stone": {
        "$description": "Warm neutral ramp. Hue sits with the cream the printed sheets use, so chrome and paper read as one family instead of grey-next-to-cream.",
        "0": {
          "$value": "#FFFFFF"
        },
        "1": {
          "$value": "#FAF9F5"
        },
        "2": {
          "$value": "#F1EFE8"
        },
        "3": {
          "$value": "#E7E4DA"
        },
        "4": {
          "$value": "#DCD8CC"
        },
        "5": {
          "$value": "#C3BEAE"
        },
        "6": {
          "$value": "#A29C8A"
        },
        "7": {
          "$value": "#8E8774"
        },
        "8": {
          "$value": "#78725F"
        },
        "9": {
          "$value": "#5A5648"
        },
        "10": {
          "$value": "#403D33"
        },
        "11": {
          "$value": "#26241D"
        },
        "12": {
          "$value": "#161510"
        }
      },
      "green": {
        "$description": "8 is the crest green sampled from the Keswick seal. 6 is the tracer's existing bright green — it passes on dark ground only, which is why light surfaces use 7.",
        "1": {
          "$value": "#EAF3ED"
        },
        "2": {
          "$value": "#D3E7DB"
        },
        "3": {
          "$value": "#A9D2BB"
        },
        "5": {
          "$value": "#3FA96B"
        },
        "6": {
          "$value": "#1C9152"
        },
        "7": {
          "$value": "#137A42"
        },
        "8": {
          "$value": "#15502C"
        },
        "9": {
          "$value": "#0F3C21"
        }
      },
      "gold": {
        "$description": "The 'modified' mark, carried over from the tracer. 3 is the tracer's #FFD23B, legible on dark only; light surfaces use 6 or 7.",
        "1": {
          "$value": "#FBF1D4"
        },
        "2": {
          "$value": "#F5DFA0"
        },
        "3": {
          "$value": "#FFD23B"
